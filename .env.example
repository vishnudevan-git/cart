# Copy this file to .env and fill in real values
# Generate a new SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Required ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here

# Set to True ONLY for local development. Never True in production.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# ── Demo login gate ───────────────────────────────────────────────────────────
# Both DEBUG=True AND ALLOW_DEMO_LOGIN=True are required to enable demo/quick-test login.
# Never set ALLOW_DEMO_LOGIN=True in production.
ALLOW_DEMO_LOGIN=False

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to SQLite (db.sqlite3) when not set.
# For production (PostgreSQL):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Demo mode uses a separate database (db_demo.sqlite3) for safe runbook testing.
# LAKRISH_DB_MODE=demo

# ── Optional features ─────────────────────────────────────────────────────────

# Show environment ribbon at top of page (useful in staging)
SHOW_ENV_RIBBON=False

# Django log level (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=WARNING
